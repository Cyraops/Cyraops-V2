DATABASE_URL=postgresql://workspace:replace-this-password@localhost:5432/company_os?schema=public
APP_URL=http://localhost:3000
INITIAL_SETUP_KEY=replace-with-a-long-random-setup-key
STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE_MB=25
POSTGRES_DB=company_os
POSTGRES_USER=workspace
POSTGRES_PASSWORD=replace-with-a-32-character-alphanumeric-password
NODE_ENV=development

# LiveKit WebRTC Configuration (Server-Side Only)
LIVEKIT_URL="http://localhost:7880"
LIVEKIT_API_KEY="replace-with-livekit-api-key"
LIVEKIT_API_SECRET="replace-with-livekit-api-secret"

# AI Provider Configuration (Server-Side Only)
# AI_PROVIDER selects the provider when more than one key is present.
# Allowed values: openai | deepseek. Defaults to openai when both keys exist.
AI_PROVIDER=""
OPENAI_API_KEY=""
OPENAI_MODEL=""
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL=""
# Voice assistant reasoning model (DeepSeek only). Allowed values:
# deepseek-flash | deepseek-v4-pro
DEEPSEEK_VOICE_MODEL=""

# Shared GoDaddy Mailbox (Server-Side Only)
# Required for CRM email drafts, IMAP sync and outbound send.
GODADDY_EMAIL_ADDRESS=""
GODADDY_EMAIL_PASSWORD=""
GODADDY_IMAP_HOST=""
GODADDY_IMAP_PORT=""
GODADDY_SMTP_HOST=""
GODADDY_SMTP_PORT=""


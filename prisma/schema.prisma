enum EmailFolderType {
  INBOX
  SENT
  DRAFTS
  STARRED
  ARCHIVE
  SPAM
  TRASH
  CUSTOM
}

model EmailAccount {
  id              String            @id @default(cuid())
  userId          String?
  workspaceId     String            @default("main")
  email           String
  name            String
  imapHost        String            @default("imap.secureserver.net")
  imapPort        Int               @default(993)
  imapTls         Boolean           @default(true)
  smtpHost        String            @default("smtpout.secureserver.net")
  smtpPort        Int               @default(465)
  smtpTls         Boolean           @default(true)
  isDefault       Boolean           @default(true)
  isActive        Boolean           @default(true)
  lastSyncedAt    DateTime?
  lastError       String?
  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  folders         EmailFolder[]
  messages        EmailMessage[]
  syncStates      EmailSyncState[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([workspaceId])
}

model EmailFolder {
  id            String            @id @default(cuid())
  accountId     String
  account       EmailAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name          String
  rawPath       String
  type          EmailFolderType   @default(CUSTOM)
  specialUse    String?
  uidValidity   String?
  lastUid       Int?
  unreadCount   Int               @default(0)
  totalCount    Int               @default(0)
  messages      EmailMessage[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([accountId, rawPath])
  @@index([accountId, type])
}

model EmailMessage {
  id            String            @id @default(cuid())
  accountId     String
  account       EmailAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  folderId      String?
  folder        EmailFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messageId     String?
  threadId      String?
  uid           Int?
  remoteUid     Int?
  idempotencyKey String?          @unique
  deliveryStatus String           @default("SENT")
  imapAppendStatus String?
  smtpResponse  String?           @db.Text
  lastError     String?           @db.Text
  sentAttempts  Int               @default(0)
  fromName      String?
  fromEmail     String
  replyTo       String?
  toRecipients  String            @db.Text
  ccRecipients  String?           @db.Text
  bccRecipients String?           @db.Text
  subject       String            @default("(No Subject)")
  snippet       String?           @db.Text
  bodyText      String?           @db.Text
  bodyHtml      String?           @db.Text
  isRead        Boolean           @default(false)
  isStarred     Boolean           @default(false)
  isDraft       Boolean           @default(false)
  isArchived    Boolean           @default(false)
  hasAttachments Boolean          @default(false)
  sentAt        DateTime?
  receivedAt    DateTime          @default(now())
  sizeBytes     Int               @default(0)
  attachments   EmailAttachment[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([accountId, folderId])
  @@index([userId])
  @@index([accountId, receivedAt])
  @@index([accountId, isStarred])
  @@index([accountId, isRead])
  @@index([accountId, uid])
}

model EmailAttachment {
  id          String        @id @default(cuid())
  messageId   String
  message     EmailMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename    String
  contentType String        @default("application/octet-stream")
  sizeBytes   Int           @default(0)
  contentId   String?
  storagePath String
  createdAt   DateTime      @default(now())

  @@index([messageId])
}

model EmailSyncState {
  id          String        @id @default(cuid())
  accountId   String
  account     EmailAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  folderName  String
  uidValidity String?
  highestUid  Int?
  lastSyncedAt DateTime     @default(now())

  @@unique([accountId, folderName])
}


model Expense {
  id                  String                @id @default(cuid())
  title               String
  description         String?               @db.Text
  amount              Float
  currency            String                @default("INR")
  exchangeRate        Float                 @default(1.0)
  exchangeRateDate    DateTime              @default(now())
  exchangeRateSource  String                @default("SYSTEM_BASELINE")
  amountBase          Float                 // in base currency (INR)
  baseCurrency        String                @default("INR")
  classification      ExpenseClassification @default(OPEX)
  categoryId          String
  category            ExpenseCategory       @relation("CategoryExpenses", fields: [categoryId], references: [id])
  subcategoryId       String?
  subcategory         ExpenseCategory?      @relation("SubCategoryExpenses", fields: [subcategoryId], references: [id])
  paymentMethod       ExpensePaymentMethod  @default(BANK_TRANSFER)
  paymentStatus       ExpensePaymentStatus  @default(PAID)
  paymentDate         DateTime              @default(now())
  vendor              String
  invoiceNumber       String?
  isRecurring         Boolean               @default(false)
  recurringExpenseId  String?
  recurringExpense    RecurringExpense?     @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  recurringPeriodKey  String?               // e.g. "2026-11" for monthly idempotency
  taxAmount           Float                 @default(0)
  notes               String?               @db.Text
  userId              String
  user                User                  @relation("UserExpenses", fields: [userId], references: [id])
  attachments         ExpenseAttachment[]
  invoices            InvoiceRecord[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([recurringExpenseId, recurringPeriodKey])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([userId])
  @@index([paymentDate])
  @@index([paymentStatus])
  @@index([classification])
  @@index([vendor])
}

model ExpenseAttachment {
  id          String   @id @default(cuid())
  expenseId   String
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  filename    String
  storagePath String
  contentType String   @default("application/octet-stream")
  sizeBytes   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([expenseId])
}

model InvoiceRecord {
  id             String        @id @default(cuid())
  expenseId      String?
  expense        Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  vendor         String
  invoiceNumber  String
  invoiceDate    DateTime?
  dueDate        DateTime?
  totalAmount    Float
  currency       String        @default("INR")
  fileKey        String
  fileName       String
  fileSize       Int           @default(0)
  contentType    String        @default("application/pdf")
  fileHash       String
  status         InvoiceStatus @default(DRAFT)
  extractedData  String?       @db.Text
  confidence     Float         @default(0)
  verifiedAt     DateTime?
  verifiedBy     String?
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([expenseId])
  @@index([vendor, invoiceNumber])
  @@index([fileHash])
  @@index([status])
}

model Investment {
  id                 String         @id @default(cuid())
  title              String
  investorName       String
  investorType       InvestorType   @default(FOUNDER)
  type               InvestmentType @default(FOUNDER_CAPITAL)
  amount             Float
  currency           String         @default("INR")
  exchangeRate       Float          @default(1.0)
  exchangeRateDate   DateTime       @default(now())
  exchangeRateSource String         @default("SYSTEM_BASELINE")
  amountBase         Float          // in base currency (INR)
  baseCurrency       String         @default("INR")
  date               DateTime       @default(now())
  equityPercentage   Float?
  notes              String?        @db.Text
  referenceNumber    String?
  userId             String
  user               User           @relation("UserInvestments", fields: [userId], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([userId])
  @@index([investorType])
  @@index([type])
  @@index([date])
}

model RecurringExpense {
  id                 String               @id @default(cuid())
  title              String
  vendor             String
  amount             Float
  currency           String               @default("INR")
  exchangeRate       Float                @default(1.0)
  exchangeRateDate   DateTime             @default(now())
  exchangeRateSource String               @default("SYSTEM_BASELINE")
  amountBase         Float                // in base currency (INR)
  baseCurrency       String               @default("INR")
  categoryId         String
  category           ExpenseCategory      @relation(fields: [categoryId], references: [id])
  billingCycle       BillingCycle         @default(MONTHLY)
  nextDueDate        DateTime
  startDate          DateTime             @default(now())
  endDate            DateTime?
  autoRenew          Boolean              @default(true)
  status             RecurringStatus      @default(ACTIVE)
  paymentMethod      ExpensePaymentMethod @default(CREDIT_CARD)
  notes              String?              @db.Text
  userId             String
  user               User                 @relation("UserRecurringExpenses", fields: [userId], references: [id])
  expenses           Expense[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([categoryId])
  @@index([userId])
  @@index([status])
  @@index([nextDueDate])
}

model AIUsageRecord {
  id                  String     @id @default(cuid())
  provider            AIProvider @default(DEEPSEEK)
  model               String
  purpose             String     @default("GENERAL")
  promptTokens        Int        @default(0)
  completionTokens    Int        @default(0)
  totalTokens         Int        @default(0)
  costAmount          Float      @default(0)
  currency            String     @default("USD")
  exchangeRate        Float      @default(86.5) // USD to INR benchmark
  exchangeRateDate    DateTime   @default(now())
  exchangeRateSource  String     @default("SYSTEM_BASELINE")
  costAmountBase      Float      @default(0) // in base currency (INR)
  baseCurrency        String     @default("INR")
  isReconciled        Boolean    @default(false)
  reconciledExpenseId String?
  usageDate           DateTime   @default(now())
  billedPeriod        String?
  notes               String?    @db.Text
  createdAt           DateTime   @default(now())

  @@index([provider])
  @@index([model])
  @@index([usageDate])
  @@index([billedPeriod])
  @@index([isReconciled])
}

model MarketingCampaign {
  id                  String                @id @default(cuid())
  name                String
  platform            MarketingPlatform     @default(GOOGLE_ADS)
  campaignType        MarketingCampaignType @default(SEARCH_ADS)
  spentAmount         Float                 @default(0)
  currency            String                @default("INR")
  exchangeRate        Float                 @default(1.0)
  exchangeRateDate    DateTime              @default(now())
  exchangeRateSource  String                @default("SYSTEM_BASELINE")
  spentAmountBase     Float                 @default(0) // in base currency (INR)
  baseCurrency        String                @default("INR")
  isReconciled        Boolean               @default(false)
  reconciledExpenseId String?
  leadsGenerated      Int                   @default(0)
  clientsAcquired     Int                   @default(0)
  revenueGenerated    Float                 @default(0)
  connectsUsed        Int                   @default(0)
  proposalsSent       Int                   @default(0)
  startDate           DateTime              @default(now())
  endDate             DateTime?
  notes               String?               @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([platform])
  @@index([startDate])
  @@index([isReconciled])
}

model CostAuditLog {
  id         String          @id @default(cuid())
  userId     String?
  userEmail  String?
  action     CostAuditAction
  entityType CostAuditEntity
  entityId   String
  details    String?         @db.Text
  ipAddress  String?
  createdAt  DateTime        @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model BusinessReadinessItem {
  id          String    @id @default(cuid())
  category    String    // COMPANY_PROFILE, SERVICE_OFFERINGS, PORTFOLIO, TEAM_PROFILES, FREELANCE_PLATFORMS, PROPOSALS, DELIVERY, BILLING_LEGAL
  title       String
  description String    @db.Text
  status      String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED, BLOCKED
  ownerId     String?
  notes       String?   @db.Text
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([category, status])
  @@index([ownerId])
}

model Proposal {
  id               String   @id @default(cuid())
  dealId           String
  title            String
  clientName       String
  problemStatement String   @db.Text
  solution         String   @db.Text
  scope            String   @db.Text
  deliverables     String   @db.Text // JSON array or formatted text
  technologies     String   @default("[]") @db.Text // JSON array
  timeline         String
  pricing          Float    @default(0)
  currency         String   @default("INR")
  paymentTerms     String   @db.Text
  assumptions      String?  @db.Text
  validityDays     Int      @default(14)
  status           String   @default("DRAFT") // DRAFT, INTERNAL_REVIEW, READY_TO_SEND, SENT, ACCEPTED, REJECTED
  version          Int      @default(1)
  authorId         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deal             Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  author           User      @relation("ProposalAuthor", fields: [authorId], references: [id])
  acceptedAt       DateTime?
  acceptedByUserId String?
  acceptanceChannel String?
  acceptanceReference String?
  acceptanceNotes  String?   @db.Text
  acceptedByUser   User?     @relation("ProposalAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([dealId, status])
  @@index([authorId])
  @@index([acceptedByUserId])
}

model ProjectMilestone {
  id            String    @id @default(cuid())
  projectId     String
  title         String
  description   String    @default("") @db.Text
  dueDate       DateTime?
  status        String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, BLOCKED
  deliverables  String    @default("[]") @db.Text // JSON array
  billingAmount Float     @default(0)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

model ClientInvoice {
  id              String    @id @default(cuid())
  projectId       String?
  dealId          String?
  clientCompanyId String?
  invoiceNumber   String    @unique
  title           String
  amount          Float     @default(0)
  currency        String    @default("INR")
  issueDate       DateTime  @default(now())
  dueDate         DateTime?
  amountPaid      Float     @default(0)
  status          String    @default("DRAFT") // DRAFT, ISSUED, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  paymentMethod   String?
  paidAt          DateTime?
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  deal            Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  clientCompany   Company?  @relation(fields: [clientCompanyId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([dealId])
  @@index([clientCompanyId])
  @@index([status, dueDate])
}

model PortfolioItem {
  id           String   @id @default(cuid())
  title        String
  category     String   @default("Cloud & DevOps")
  description  String   @db.Text
  problem      String   @db.Text
  solution     String   @db.Text
  workDone     String   @db.Text
  outcome      String   @db.Text
  technologies String   @default("[]") @db.Text // JSON array
  isRealClient Boolean  @default(false)
  clientName   String?
  isPublic     Boolean  @default(true)
  metrics      String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category, isPublic])
}


model Assistant {
  id           String             @id @default(cuid())
  userId       String             @unique
  name         String             @default("Cyraops Assistant")
  systemPrompt String             @default("") @db.Text
  model        String             @default("deepseek-flash")
  temperature  Float              @default(0.3)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  messages      AssistantMessage[]
  memories      AssistantMemory[]
  conversations AssistantConversation[]
  chatMessages  Message[]        @relation("AssistantMessages")
  approvalMode  String             @default("ASK")
  approvalRules AssistantApprovalRule[]
}

/// A standing answer to "may the assistant do this?" — created from an approval
/// card, never from a form, so the list stays exact rather than guessed.
model AssistantApprovalRule {
  id          String    @id @default(cuid())
  assistantId String
  toolName    String
  effect      String
  createdAt   DateTime  @default(now())
  assistant   Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  @@unique([assistantId, toolName])
  @@index([assistantId])
}

model AssistantConversation {
  id          String             @id @default(cuid())
  assistantId String
  title       String             @default("New chat")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  /// Rolling summary of everything older than the live window, so a long
  /// conversation keeps its thread instead of being silently truncated.
  summary     String?            @db.Text
  summaryUpTo DateTime?
  summarizedCount Int            @default(0)
  /// Pinned chats stay at the top; archived ones fold away without being lost.
  pinnedAt    DateTime?
  archivedAt  DateTime?
  /// Project-work harness (Phase A): the project root the harness bot turns
  /// run under, exactly as the owner supplied it. Null = CRM mode (no root).
  /// This is the conversation the HARNESS_BOT chat stream actually turns
  /// under, so the authoritative copy for the turn path lives here; the same
  /// columns exist on AiConversation per the Phase A schema spec.
  workspaceRoot String?
  /// Server-resolved realpath of workspaceRoot (absolute, canonical).
  workspaceRootRealpath String?
  /// Null for the personal assistant; set to a specialist's slug for a thread
  /// with that AI teammate.
  agentSlug   String?
  assistant   Assistant          @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  messages    AssistantMessage[]

  @@index([assistantId, updatedAt])
  @@index([assistantId, agentSlug, updatedAt])
}

model AssistantMessage {
  id             String                @id @default(cuid())
  assistantId    String
  conversationId String?
  role           String
  content        String                @db.Text
  toolCalls      String?
  attachments    String?               @db.Text
  createdAt      DateTime              @default(now())
  assistant      Assistant             @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  conversation   AssistantConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([assistantId, createdAt])
  @@index([conversationId, createdAt])
}

model AssistantMemory {
  id          String    @id @default(cuid())
  assistantId String
  content     String    @db.Text
  /// Bumped whenever the user or the assistant corrects this fact.
  revision    Int       @default(1)
  /// Set instead of deleting, so a forgotten fact stays auditable.
  archivedAt  DateTime?
  /// True when the user wrote or edited it by hand: never auto-pruned.
  pinned      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  assistant   Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  @@index([assistantId, createdAt])
  @@index([assistantId, archivedAt])
}

model AssistantAttachment {
  id          String   @id @default(cuid())
  assistantId String
  name        String
  storageKey  String
  mimeType    String
  size        Int
  createdAt   DateTime @default(now())

  @@index([assistantId, createdAt])
}

model AssistantPendingAction {
  id             String   @id @default(cuid())
  assistantId    String
  userId         String
  conversationId String?
  toolId         String
  toolName       String
  input          String   @db.Text
  summary        String   @db.Text
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, status, createdAt])
}

/// A user-supplied, OpenAI-compatible model provider ("bring your own key").
model AiProviderConfig {
  id              String   @id @default(cuid())
  label           String
  baseUrl         String
  defaultModel    String
  apiKeyEncrypted String   @db.Text
  apiKeyHint      String   @default("")
  isActive        Boolean  @default(true)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
}

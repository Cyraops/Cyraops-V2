generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// The unified Cyraops Permission Manager mode (see CYRAOPS_PERMISSION_AUDIT.md §8).
/// Stored per workspace; an agent-level override wins when set.
enum PermissionMode {
  READ_ONLY
  CONTROLLED
  FULL_CONTROL
  SYSTEM
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

/// Where a ticket came from. Mirrors a service desk's Source property.
enum TaskSource {
  EMAIL
  PHONE
  CHAT
  WEB
  PORTAL
  API
}

/// What kind of request this is, in service-desk terms.
enum TaskType {
  SERVICE_REQUEST
  INCIDENT
  PROBLEM
  CHANGE
}

/// What kind of work a task is. Deliberately short: a bug is something broken,
/// a service is an agreed piece of work, a category is a grouping item. Null
/// means nobody classified it yet, which is visible rather than guessed.
enum TaskKind {
  BUG
  SERVICE
  CATEGORY
}

enum ConversationType {
  DIRECT
  GROUP
}

enum NotificationType {
  MESSAGE
  TASK_ASSIGNED
  TASK_COMMENT
  PROJECT_CHANGE
  DEADLINE
  SYSTEM
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  CREATED
  RINGING
  CONNECTING
  ACTIVE
  ENDING
  ENDED
  CANCELLED
  FAILED
}

enum ParticipantStatus {
  INVITED
  RINGING
  ACCEPTED
  DECLINED
  MISSED
  CANCELLED
  CONNECTING
  CONNECTED
  DISCONNECTED
  LEFT
  EJECTED
  FAILED
}

enum CallTerminationReason {
  NORMAL
  HOST_ENDED
  DECLINED
  MISSED
  TIMEOUT
  EMPTY_ROOM
  FAILED
  CANCELLED_BY_CALLER
  ERROR
}

enum CallEventType {
  CALL_CREATED
  RINGING_STARTED
  PARTICIPANT_INVITED
  PARTICIPANT_RINGING
  PARTICIPANT_ACCEPTED
  PARTICIPANT_DECLINED
  PARTICIPANT_CONNECTING
  PARTICIPANT_CONNECTED
  PARTICIPANT_DISCONNECTED
  PARTICIPANT_LEFT
  PARTICIPANT_EJECTED
  CALL_ACTIVE
  HOST_REASSIGNED
  CALL_ENDING
  CALL_ENDED
  CALL_CANCELLED
  CALL_FAILED
  TIMEOUT_TRIGGERED
  PARTICIPANT_MUTED
  PARTICIPANT_UNMUTED
}

model User {
  id                      String               @id @default(cuid())
  name                    String
  email                   String?              @unique
  passwordHash            String?
  mustChangePassword      Boolean              @default(false)
  role                    Role                 @default(MEMBER)
  avatarUrl               String?
  title                   String?
  timezone                String               @default("UTC")
  disabledAt              DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  sessions                Session[]
  setupTokens             PasswordSetupToken[]
  createdConversations    Conversation[]       @relation("ConversationCreator")
  ownedWorkspace          Workspace?           @relation("WorkspaceOwner")
  projectMemberships      ProjectMember[]
  ownedProjects           Project[]            @relation("ProjectOwner")
  assignedTasks           Task[]               @relation("TaskAssignee")
  createdTasks            Task[]               @relation("TaskCreator")
  taskComments            TaskComment[]
  projectPosts            ProjectPost[]
  conversationMemberships ConversationMember[]
  sentMessages            Message[]
  uploadedFiles           DriveFile[]
  notifications           Notification[]
  activities              Activity[]
  readMessages            MessageRead[]
  assignedLeads           Lead[]               @relation("LeadAssignee")
  ownedDeals              Deal[]               @relation("DealOwner")
  aiTasks                 AiTask[]             @relation("UserAiTasks")
  aiApprovalsRequested    AiApproval[]         @relation("ApprovalRequester")
  aiApprovalsReviewed     AiApproval[]         @relation("ApprovalReviewer")
  aiConversations         AiConversation[]     @relation("UserAiConversations")
  teamSkills              TeamSkill[]
  certifications          Certification[]
  emailAccounts           EmailAccount[]
  emailMessages           EmailMessage[]
  expenses                Expense[]            @relation("UserExpenses")
  investments             Investment[]         @relation("UserInvestments")
  recurringExpenses       RecurringExpense[]   @relation("UserRecurringExpenses")
  initiatedCalls          CallSession[]        @relation("CallInitiator")
  hostedCalls             CallSession[]        @relation("CallHost")
  callParticipations      CallParticipant[]    @relation("CallParticipantUser")
  authoredProposals       Proposal[]           @relation("ProposalAuthor")
  acceptedProposals       Proposal[]           @relation("ProposalAcceptedBy")
  readinessItems          BusinessReadinessItem[]
  uploadedAttachments     MessageAttachment[]  @relation("UploadedAttachments")
  pages                   Page[]               @relation("UserPages")
  intakeTokens            IntakeToken[]        @relation("UserIntakeTokens")
  taskAssignments         TaskAssignee[]       @relation("UserTaskAssignments")
  createdCalendarEvents CalendarEvent[] @relation("CreatedCalendarEvents")
}

/// A bearer secret that lets an outside system create leads without a session.
/// The raw token is shown once at creation; only its hash is stored.
model IntakeToken {
  id           String    @id @default(cuid())
  userId       String
  label        String
  /// What created the lead: webhook, zapier, typeform, email, ...
  source       String    @default("webhook")
  tokenHash    String    @unique
  /// Last few characters, so a person can tell tokens apart in a list.
  hint         String
  assignedToId String?
  disabledAt   DateTime?
  lastUsedAt   DateTime?
  useCount     Int       @default(0)
  createdAt    DateTime  @default(now())
  user         User      @relation("UserIntakeTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuthRateLimit {
  key        String   @id
  hits       Int      @default(0)
  windowEnds DateTime
  updatedAt  DateTime @updatedAt
}

model PasswordSetupToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Project {
  id                 String          @id @default(cuid())
  name               String
  description        String          @default("")
  status             ProjectStatus   @default(PLANNING)
  priority           Priority        @default(MEDIUM)
  deadline           DateTime?
  ownerId            String
  dealId             String?         @unique
  archivedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  owner              User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  deal               Deal?           @relation("ProjectDeal", fields: [dealId], references: [id], onDelete: SetNull)
  convertedFromDeal  Deal?           @relation("DealConvertedProject")
  members            ProjectMember[]
  tasks              Task[]
  files              DriveFile[]
  activities         Activity[]
  discussion         ProjectPost[]
  milestones         ProjectMilestone[]
  clientInvoices     ClientInvoice[]

  @@index([status, deadline])
}

model ProjectMember {
  projectId String
  userId    String
  role      String   @default("member")
  addedAt   DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model ProjectPost {
  id        String   @id @default(cuid())
  body      String
  projectId String
  authorId  String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([projectId, createdAt])
}

model Task {
  id          String        @id @default(cuid())
  /// Human-facing ticket number: #SR-<number>. Assigned by the database so two
  /// tickets can never share one, even under concurrent creation.
  number      Int           @unique @default(autoincrement())
  title       String
  description String        @default("")
  status      TaskStatus    @default(TODO)
  priority    Priority      @default(MEDIUM)
  kind        TaskKind?
  /// Service-desk properties, so a task can be worked as a ticket.
  source        TaskSource?
  type          TaskType?
  groupName     String?
  category      String?
  requesterName  String?
  requesterEmail String?
  /// What was actually done to close it. Kept separate from the description,
  /// which is what the requester said.
  resolution  String        @default("")
  closedAt    DateTime?
  dueDate     DateTime?
  projectId   String
  assigneeId  String?
  creatorId   String
  parentId    String?
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator     User          @relation("TaskCreator", fields: [creatorId], references: [id])
  parent      Task?         @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]        @relation("Subtasks")
  comments    TaskComment[]
  activities  Activity[]
  /// The full set of owners. `assigneeId` above mirrors the first human here.
  assignees   TaskAssignee[]

  @@index([projectId, status])
  @@index([assigneeId, dueDate])
  @@index([dueDate])
  @@index([kind])
  @@index([status, priority])
}

/// Who a task belongs to. A task can have several owners, and an AI agent can be
/// one of them. Exactly one of `userId` / `agentSlug` is set per row.
///
/// `Task.assigneeId` is still written as the first human so the older readers
/// (calendar, dashboard, digests, agent tools) keep working unchanged; this table
/// is the authoritative set whenever more than one owner exists.
model TaskAssignee {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  agentSlug String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User?    @relation("UserTaskAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@unique([taskId, agentSlug])
  @@index([taskId])
  @@index([userId])
}

model TaskComment {
  id        String   @id @default(cuid())
  body      String
  taskId    String
  authorId  String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

model Conversation {
  id          String               @id @default(cuid())
  type        ConversationType     @default(DIRECT)
  name        String?
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   User?                @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members     ConversationMember[]
  messages    Message[]
  callSessions CallSession[]
}

model Workspace {
  id                  String   @id @default("main")
  name                String   @default("Cyraops")
  tagline             String?
  description         String?  @db.Text
  industry            String?  @default("IT Services & Cloud Consulting")
  phone               String?
  website             String?
  address             String?  @db.Text
  timezone            String?  @default("Asia/Kolkata")
  logoUrl             String?
  socialLinks         String?  @db.Text
  registrationDetails String?  @db.Text
  /// The workspace-wide permission mode every AI turn resolves against.
  permissionMode      PermissionMode @default(CONTROLLED)
  ownerId             String   @unique
  loginEmail          String   @unique
  loginPasswordHash   String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  owner               User     @relation("WorkspaceOwner", fields: [ownerId], references: [id])
}

model ConversationMember {
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id             String        @id @default(cuid())
  clientId       String?
  body           String
  conversationId String
  senderId       String?
  agentId        String?
  assistantId    String?
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)
  agent          AiAgent?      @relation("AgentMessages", fields: [agentId], references: [id], onDelete: SetNull)
  assistant      Assistant?    @relation("AssistantMessages", fields: [assistantId], references: [id], onDelete: SetNull)
  reads          MessageRead[]
  attachments    MessageAttachment[]

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt])
  @@index([agentId, createdAt])
  @@index([assistantId, createdAt])
}

model Page {
  id             String   @id @default(cuid())
  userId         String
  conversationId String?
  title          String
  /// Always the newest version; history lives in PageVersion.
  content        String
  /// Also the share token: regenerating it revokes the previous link.
  publicSlug     String   @unique
  isPublic       Boolean  @default(false)
  /// An expiring share link, so "public" is not necessarily "forever".
  shareExpiresAt DateTime?
  currentVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation("UserPages", fields: [userId], references: [id], onDelete: Cascade)
  versions       PageVersion[]

  @@index([userId, updatedAt])
}

/// Every save, so asking for a change is never destructive and an earlier
/// version can be restored.
model PageVersion {
  id        String   @id @default(cuid())
  pageId    String
  version   Int
  title     String
  content   String
  createdAt DateTime @default(now())
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
  @@index([pageId, createdAt])
}

model MessageAttachment {
  id           String   @id @default(cuid())
  messageId    String?
  uploadedById String?
  name         String
  storageKey   String   @unique
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  message      Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation("UploadedAttachments", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([uploadedById, createdAt])
}

model MessageRead {
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model CallSession {
  id                      String                 @id @default(cuid())
  conversationId          String
  type                    CallType               @default(AUDIO)
  status                  CallStatus             @default(CREATED)
  initiatorId             String
  hostId                  String
  livekitRoomName         String                 @unique
  screenShareEnabled      Boolean                @default(false)
  screenShareHostId       String?
  ringTimeoutAt           DateTime?
  staleConnectingTimeoutAt DateTime?
  emptyRoomTimeoutAt      DateTime?
  startedAt               DateTime?
  endedAt                 DateTime?
  terminationReason       CallTerminationReason?
  terminationDetail       String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  conversation            Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  initiator               User                   @relation("CallInitiator", fields: [initiatorId], references: [id], onDelete: Restrict)
  host                    User                   @relation("CallHost", fields: [hostId], references: [id], onDelete: Restrict)
  participants            CallParticipant[]
  events                  CallEvent[]
  sfuEjectionJobs         CallSfuEjectionJob[]

  @@index([conversationId, status])
  @@index([status, ringTimeoutAt])
  @@index([status, staleConnectingTimeoutAt])
  @@index([status, emptyRoomTimeoutAt])
}

model CallParticipant {
  id             String            @id @default(cuid())
  callSessionId  String
  userId         String
  status         ParticipantStatus @default(INVITED)
  isHost         Boolean           @default(false)
  canPublish     Boolean           @default(true)
  canSubscribe   Boolean           @default(true)
  invitedAt      DateTime          @default(now())
  ringingAt      DateTime?
  answeredAt     DateTime?
  joinedAt       DateTime?
  disconnectedAt DateTime?
  leftAt         DateTime?
  failureReason  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  callSession    CallSession       @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  user           User              @relation("CallParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callSessionId, userId])
  @@index([userId, status])
  @@index([callSessionId, status])
}


/// A meeting that is not a task: what the calendar needs to exist as its own
/// thing. Tasks show up as due dates; this is for "put a call on Thursday".
model CalendarEvent {
  id        String   @id @default(cuid())
  title     String
  notes     String   @default("")
  location  String?
  startsAt  DateTime
  endsAt    DateTime
  /// Comma separated addresses. Kept as text because an attendee need not be a
  /// user in this workspace.
  attendees String   @default("")
  creatorId String
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator   User     @relation("CreatedCalendarEvents", fields: [creatorId], references: [id])

  @@index([startsAt])
}

model CallEvent {
  id            String        @id @default(cuid())
  callSessionId String
  type          CallEventType
  actorId       String?
  targetUserId  String?
  payload       Json?
  dedupeKey     String?       @unique
  createdAt     DateTime      @default(now())
  callSession   CallSession   @relation(fields: [callSessionId], references: [id], onDelete: Cascade)

  @@index([callSessionId, createdAt])
}

model CallIdempotencyKey {
  key           String    @id
  userId        String?
  endpoint      String?
  payloadHash   String?
  status        String    @default("COMPLETED")
  lockedAt      DateTime?
  callSessionId String?
  responseJson  String?
  statusCode    Int?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([userId, endpoint])
  @@index([expiresAt])
}

model CallSfuEjectionJob {
  id            String          @id @default(cuid())
  callSessionId String
  roomName      String
  userId        String
  status        OutboxJobStatus @default(PENDING)
  attempts      Int             @default(0)
  maxAttempts   Int             @default(5)
  lastError     String?
  nextRetryAt   DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  completedAt   DateTime?
  callSession   CallSession     @relation(fields: [callSessionId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([callSessionId])
  @@index([userId])
}

model DriveFile {
  id         String    @id @default(cuid())
  name       String
  storageKey String    @unique
  mimeType   String
  size       Int
  projectId  String
  uploaderId String
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader   User      @relation(fields: [uploaderId], references: [id])

  @@index([projectId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String           @default("")
  href      String?
  userId    String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  dedupeKey String?          @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  summary   String
  userId    String
  projectId String?
  taskId    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}

enum OutboxJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum DealStage {
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum ContactStatus {
  LEAD
  CUSTOMER
  PARTNER
  INACTIVE
}

enum AiTaskStatus {
  CREATED
  PLANNING
  AWAITING_APPROVAL
  READY
  RUNNING
  WAITING_FOR_AGENT
  WAITING_FOR_EXTERNAL_RESULT
  PAUSED
  RECOVERING
  COMPLETED
  FAILED
  CANCELLED
}

enum RiskClass {
  CLASS_A
  CLASS_B
  CLASS_C
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MemoryType {
  CONVERSATION
  AGENT
  USER
  COMPANY
}

model Company {
  id          String    @id @default(cuid())
  name        String
  domain      String?
  industry    String?
  size        String?
  website     String?
  phone       String?
  address     String?
  notes       String    @default("")
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  contacts       Contact[]
  deals          Deal[]
  leads          Lead[]
  clientInvoices ClientInvoice[]

  @@index([name])
  @@index([archivedAt])
}

model Contact {
  id          String        @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  title       String?
  status      ContactStatus @default(LEAD)
  companyId   String?
  notes       String        @default("")
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  // Owning workspace (the owning user's id, per the app's tenant model: the
  // workspace key the harness bridge and memberContactWhere use). Nullable:
  // rows that predate the column, or whose only owner path (linked
  // deals/leads) is ambiguous, keep null and remain scoped by those links.
  workspaceId String?
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals       Deal[]
  leads       Lead[]

  @@index([email])
  @@index([companyId])
  @@index([archivedAt])
  @@index([workspaceId])
}

model Lead {
  id             String     @id @default(cuid())
  title          String
  contactId      String?
  companyId      String?
  companyName    String?
  email          String?
  phone          String?
  status         LeadStatus @default(NEW)
  score          Int        @default(0)
  source         String?
  estimatedValue Float?
  assignedToId   String?
  notes          String     @default("")
  archivedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  contact        Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company        Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedTo     User?      @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, score])
  @@index([assignedToId])
  @@index([companyId])
  @@index([archivedAt])
}

model Deal {
  id                 String                 @id @default(cuid())
  title              String
  value              Float                  @default(0)
  currency           String                 @default("INR")
  stage              DealStage              @default(DISCOVERY)
  probability        Int                    @default(20)
  expectedCloseDate  DateTime?
  companyId          String?
  contactId          String?
  ownerId            String?
  sourcePlatform     String?                // UPWORK, FREELANCER, FIVERR, LINKEDIN, DIRECT, REFERRAL, OTHER
  externalUrl        String?
  nextAction         String?
  followUpDate       DateTime?
  notes              String                 @default("")
  archivedAt         DateTime?
  convertedProjectId String?                @unique
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  company            Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact            Contact?               @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner              User?                  @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  convertedProject   Project?               @relation("DealConvertedProject", fields: [convertedProjectId], references: [id], onDelete: SetNull)
  fitAssessments     ProjectFitAssessment[]
  project            Project?               @relation("ProjectDeal")
  proposals          Proposal[]
  clientInvoices     ClientInvoice[]

  @@index([stage])
  @@index([ownerId])
  @@index([sourcePlatform])
  @@index([followUpDate])
  @@index([archivedAt])
}

model AiAgent {
  id            String           @id @default(cuid())
  slug          String           @unique
  name          String
  role          String
  description   String
  systemPrompt  String           @db.Text
  modelProfile  String           @default("reasoning")
  temperature   Float            @default(0.3)
  maxTokens     Int              @default(4096)
  status        String           @default("ACTIVE")
  isMaster      Boolean          @default(false)
  /// A shipped starting point. Templates can be cloned but not edited or
  /// deleted, so everyone's "start from Sales Agent" stays the same.
  isTemplate    Boolean          @default(false)
  version       String           @default("1.0.0")
  tools         String           @default("[]")
  permissions   String           @default("[]")
  /// Per-agent override of the workspace permission mode; null inherits it.
  permissionMode PermissionMode?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tasks         AiTask[]         @relation("AssignedAgent")
  conversations AiConversation[]
  messages      Message[]        @relation("AgentMessages")
  routines      AiRoutine[]
}

model AiTask {
  id               String         @id @default(cuid())
  parentId         String?
  objective        String         @db.Text
  prompt           String         @db.Text
  assignedAgentId  String
  requestingUserId String
  status           AiTaskStatus   @default(CREATED)
  priority         Priority       @default(MEDIUM)
  plan             String         @default("[]") @db.Text
  result           String?        @db.Text
  error            String?        @db.Text
  retryCount       Int            @default(0)
  maxRetries       Int            @default(3)
  idempotencyKey   String?        @unique
  workerId         String?
  leaseExpiresAt   DateTime?
  lastHeartbeat    DateTime?
  recoveryMetadata String?        @db.Text
  currentStepIndex Int            @default(1)
  conversationId   String?
  /// The objective this task contributes to, when it came from a goal.
  goalId           String?
  goal             AiGoal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  assignedAgent    AiAgent        @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  requestingUser   User           @relation("UserAiTasks", fields: [requestingUserId], references: [id])
  parent           AiTask?        @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks         AiTask[]       @relation("SubTasks")
  steps            AiTaskStep[]
  approvals        AiApproval[]
  toolCalls        AiToolCall[]

  @@index([status, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([requestingUserId])
}

model AiTaskStep {
  id                String       @id @default(cuid())
  taskId            String
  stepIndex         Int
  title             String
  description       String       @default("")
  assignedAgentSlug String?
  status            AiTaskStatus @default(CREATED)
  input             String       @default("{}") @db.Text
  output            String?      @db.Text
  error             String?      @db.Text
  requiresApproval  Boolean      @default(false)
  approvalId        String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  task              AiTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  toolCalls         AiToolCall[]

  @@unique([taskId, stepIndex])
  @@index([taskId, status])
}

model AiApproval {
  id             String         @id @default(cuid())
  taskId         String
  stepIndex      Int?
  proposedAction String
  riskClass      RiskClass      @default(CLASS_B)
  description    String         @db.Text
  payload        String         @default("{}") @db.Text
  status         ApprovalStatus @default(PENDING)
  requestedById  String
  reviewedById   String?
  reviewNotes    String?
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  task           AiTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy    User           @relation("ApprovalRequester", fields: [requestedById], references: [id])
  reviewedBy     User?          @relation("ApprovalReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
}

model AiToolCall {
  id               String      @id @default(cuid())
  /// Null for assistant chat calls, which belong to a conversation not a task.
  taskId           String?
  /// Set when the call came from the personal assistant.
  conversationId   String?
  stepId           String?
  toolId           String
  toolName         String
  idempotencyKey   String?
  input            String      @db.Text
  output           String?     @db.Text
  status           String      @default("SUCCESS")
  error            String?     @db.Text
  riskClass        RiskClass   @default(CLASS_A)
  requiresApproval Boolean     @default(false)
  executionTimeMs  Int         @default(0)
  createdAt        DateTime    @default(now())
  task             AiTask?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  step             AiTaskStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([conversationId, createdAt])
  @@index([toolName])
  @@index([idempotencyKey])
}

model AiConversation {
  id        String        @id @default(cuid())
  agentId   String
  userId    String
  title     String        @default("New Conversation")
  /// The DeepSeek Harness durable session id the AgentRuntime adapter maps
  /// onto this conversation; null until the first turn announces one.
  harnessSessionId String?
  /// Project-work harness (Phase A): the project root the harness turn runs
  /// under, exactly as the owner supplied it. Null = CRM mode (no root).
  /// Only the conversation's owner may set or clear it.
  workspaceRoot String?
  /// The server-resolved canonical path (realpath) of workspaceRoot — the
  /// value the runtimes actually map into the sandbox. Stored beside the
  /// user-supplied spelling so the UI can show what was typed while the
  /// sandbox uses the resolved directory.
  workspaceRootRealpath String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  agent     AiAgent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user      User          @relation("UserAiConversations", fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String         @db.Text
  toolCalls      String?        @db.Text
  reasoning      String?        @db.Text
  tokenCount     Int            @default(0)
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AiSkill {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  description     String
  instructions    String      @db.Text
  requiredTools   String      @default("[]")
  inputSchema     String      @default("{}")
  outputSchema    String      @default("{}")
  version         String      @default("1.0.0")
  isEnabled       Boolean     @default(true)
  isCompanyShared Boolean     @default(true)
  createdById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  routines        AiRoutine[]

  @@index([slug])
}

model AiRoutine {
  id             String    @id @default(cuid())
  name           String
  description    String    @default("")
  cronExpression String
  skillId        String
  agentId        String
  isEnabled      Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  lastStatus     String?
  /// SCHEDULE | WEBHOOK | EMAIL | RECORD_CHANGE
  triggerType    String    @default("SCHEDULE")
  /// Bearer token for the webhook trigger (also the public path segment).
  webhookToken   String?   @unique
  /// Only fire for mail from these senders (EMAIL trigger).
  emailSenders   String    @default("")
  /// Record-change watcher, e.g. "Deal:stage".
  watchModel     String?
  watchField     String?
  /// Last value seen by the watcher, so it fires on change rather than on poll.
  watchValue     String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  skill          AiSkill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  agent          AiAgent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runs           RoutineRun[]

  @@index([isEnabled, nextRunAt])
}

/// A standing objective the AI team works on until it is achieved.
///
/// Tasks existed before, but nothing bound them to an outcome: a task finished
/// and the story ended. A goal is the thing that keeps looping — plan, delegate,
/// check whether it actually achieved anything, and go again.
model AiGoal {
  id              String    @id @default(cuid())
  title           String
  objective       String    @db.Text
  successCriteria String    @db.Text
  /// ACTIVE | ACHIEVED | PAUSED | CANCELLED | FAILED
  status          String    @default("ACTIVE")
  round           Int       @default(0)
  maxRounds       Int       @default(10)
  lastEvaluation  String?   @db.Text
  lastAdvancedAt  DateTime?
  /// Countable outcome that makes "achieved" verifiable: leads | deals | tasks | contacts.
  metric          String?
  /// The minimum number of that metric the goal must produce to count as done.
  minValue        Int?
  achievedAt      DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tasks           AiTask[]
  messages        AiAgentMessage[]

  @@index([status, lastAdvancedAt])
}

/// The team's shared conversation. Every plan, hand-off and result lands here,
/// so agents are collaborating in one visible thread rather than in isolation.
model AiAgentMessage {
  id            String   @id @default(cuid())
  goalId        String
  fromAgentSlug String?
  toAgentSlug   String?
  /// AGENT | SYSTEM | USER | RESULT
  kind          String   @default("AGENT")
  body          String   @db.Text
  taskId        String?
  createdAt     DateTime @default(now())
  goal          AiGoal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
}

/// One attempt at one scheduled occurrence.
///
/// The old scheduler ran inside the web process on a `setInterval`, so every
/// routine run was lost on redeploy and two replicas would have double-run.
/// A row per occurrence plus a lease makes execution durable, retryable and
/// inspectable.
model RoutineRun {
  id             String    @id @default(cuid())
  routineId      String
  /// The occurrence this run belongs to; also the de-duplication key.
  scheduledFor   DateTime
  status         String    @default("PENDING")
  attempt        Int       @default(0)
  maxAttempts    Int       @default(2)
  leaseOwner     String?
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  error          String?   @db.Text
  result         String?   @db.Text
  createdAt      DateTime  @default(now())
  routine        AiRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, scheduledFor])
  @@index([status, scheduledFor])
  @@index([routineId, createdAt])
}

model AiMemory {
  id        String     @id @default(cuid())
  type      MemoryType @default(COMPANY)
  key       String
  content   String     @db.Text
  metadata  String     @default("{}")

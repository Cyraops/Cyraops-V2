{
  "name": "cyraops-crm",
  "version": "1.0.0",
  "description": "Cyraops CRM collaboration workspace",
  "main": "index.js",
  "scripts": {
    "dev": "PORT=3001 next dev --hostname 0.0.0.0 --port 3001",
    "build": "prisma generate && next build",
    "lint": "eslint .",
    "start": "NODE_ENV=production tsx server.ts",
    "build:marketing": "(cd marketing-source && VITE_CMS_URL=/login npm run build) && CYRAOPS_SITE_DIST=marketing-source/dist npm run sync:marketing",
    "promote": "./promote-to-prod.sh",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./test/preload.mjs --test --test-concurrency=1 \"src/lib/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "sync:marketing": "node scripts/sync-marketing-site.mjs",
    "start:azure": "prisma migrate deploy && npm start",
    "test:unit": "node --import tsx --import ./test/preload.mjs --test --test-concurrency=1 \"src/lib/**/*.test.ts\"",
    "test:jobs": "node --import tsx --import ./test/preload.mjs --test --test-concurrency=1 test/jobs/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.6.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "imapflow": "^2.10.0",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "lucide-react": "^1.65.0",
    "mailparser": "^3.14.1",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "openai": "^7.47.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.18.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  },
  "engines": {
    "node": ">=22 <25"
  }
}

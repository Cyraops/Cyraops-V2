{
  "manifest_version": 3,
  "name": "Cyraops Browser Agent",
  "version": "0.1.0",
  "description": "Lets the Cyraops assistant work in a browser tab on this computer, instead of a server.",
  "permissions": ["debugger", "tabs", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:3001/*", "http://localhost:3001/*", "https://www.cyraops.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:3001/*", "http://localhost:3001/*", "https://www.cyraops.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Cyraops Browser Agent" }
}
